# Vendored and generated frontend artifacts are byte-for-byte copies of a
# pinned source. Rewriting their line endings on checkout - what
# core.autocrlf=true does on a Windows clone - hands the working copy a file
# that differs from the committed blob, so a digest check on one cannot hold.
workspace/**/static/**/vendor/** -text
workspace/common/static/css/app.css -text

# Shell scripts run inside the Linux image whatever the host they were checked
# out on, and CRLF line endings break them (run.sh is the image's command).
*.sh text eol=lf

# Mail fixtures hold raw 8-bit bytes and CRLF line endings: any conversion
# makes them another message than the one the parser tests describe.
workspace/mail/tests/corpus/*.eml -text

# Mounted into a Linux container whatever the host it was checked out on.
workspace/mail/tests/live/*.conf text eol=lf
