# Workspace settings for the Synology package.
#
# Edit this file (File Station, Text Editor), then stop and start the
# Workspace package in Package Center: every container reads it when it
# starts. It is a shell file: one KEY=value per line, quote a value that
# holds a space or a special character ('like this'), # starts a comment.
#
# Every variable is documented at
# https://github.com/JaaJSoft/workspace/tree/main/docs/deployments
#
# SECRET_KEY and the Web Push keys are generated in .secrets.env next to
# this file; a value set here takes precedence.

# --- HTTPS -------------------------------------------------------------------
# Once Workspace is published over HTTPS (Control Panel > Login Portal >
# Advanced > Reverse Proxy), restrict the hostnames, trust the public origin
# and send the session cookies over HTTPS only. NUM_PROXIES=1 tells
# Workspace the client address is the one the reverse proxy forwards.
#ALLOWED_HOSTS=workspace.example.com
#CSRF_TRUSTED_ORIGINS=https://workspace.example.com
#SESSION_COOKIE_SECURE=1
#CSRF_COOKIE_SECURE=1
#NUM_PROXIES=1

# --- Resources ---------------------------------------------------------------
# Each web worker holds about 170 MB; each background process holds its own
# copy of the models its tasks load (photo analysis, file type detection).
#GUNICORN_WORKERS=1
#CELERY_WORKER_CONCURRENCY=2

# --- Web Push ----------------------------------------------------------------
#WEBPUSH_VAPID_MAILTO=mailto:admin@example.com

# --- Single sign-on (OIDC) ---------------------------------------------------
# Redirect URI to register with the provider: <origin>/oidc/callback
#OIDC_RP_CLIENT_ID=
#OIDC_RP_CLIENT_SECRET=
#OIDC_OP_AUTHORIZATION_ENDPOINT=
#OIDC_OP_TOKEN_ENDPOINT=
#OIDC_OP_USER_ENDPOINT=
#OIDC_OP_JWKS_ENDPOINT=
#OIDC_PROVIDER_NAME=OpenID

# --- Mail sign-in with Google or Microsoft (OAuth2) --------------------------
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=
#OAUTH_MICROSOFT_CLIENT_ID=
#OAUTH_MICROSOFT_CLIENT_SECRET=

# --- AI assistants -----------------------------------------------------------
#AI_API_KEY=
#AI_BASE_URL=
#AI_MODEL=gpt-5

# --- Prometheus /metrics -----------------------------------------------------
#METRICS_USER=
#METRICS_PASSWORD=
