{
  "name": "workspace-frontend",
  "version": "1.0.0",
  "description": "Build of every vendored frontend asset for the workspace Django project: the Alpine.js bundle and the Lucide icon library loaded by base.html, the Milkdown Crepe editor bundle and its theme CSS, the Monaco editor bundle with its workers and stylesheet, the emoji picker and its emoji data, the force-graph module behind the notes graph, the FullCalendar and Cropper global builds, the vault client cryptography bundles, and the Tailwind + DaisyUI stylesheet. Everything is committed to statics and served via whitenoise so no page depends on a CDN at runtime. Rebuild with `npm run build` after bumping any pinned version.",
  "private": true,
  "scripts": {
    "build": "npm run build:alpine && npm run build:lucide && npm run build:editor && npm run build:editor-css && npm run build:monaco && npm run build:monaco-workers && npm run build:monaco-css && npm run build:emoji-picker && npm run build:emoji-data && npm run build:force-graph && npm run build:calendar && npm run build:cropper && npm run build:vault && npm run build:vault-onboarding && npm run build:css",
    "build:alpine": "esbuild alpine-bundle.js --bundle --format=iife --minify --target=es2022 --outfile=../../workspace/common/static/ui/js/vendor/alpine/alpine.js",
    "build:lucide": "node vendor-copy.mjs lucide",
    "build:editor": "esbuild milkdown-editor.js --bundle --format=esm --splitting --minify --target=es2022 --outdir=../../workspace/files/ui/static/files/ui/js/vendor/milkdown --chunk-names=chunk-[hash]",
    "build:editor-css": "esbuild milkdown-theme.css --bundle --minify --loader:.woff2=file --loader:.woff=empty --loader:.ttf=empty --asset-names=fonts/[name] --outfile=../../workspace/files/ui/static/files/ui/css/vendor/milkdown/theme.css",
    "build:monaco": "esbuild monaco-editor.js --bundle --format=esm --splitting --minify --target=es2022 --loader:.css=empty --outdir=../../workspace/files/ui/static/files/ui/js/vendor/monaco --chunk-names=chunk-[hash]",
    "build:monaco-workers": "esbuild node_modules/monaco-editor/esm/vs/editor/editor.worker.js node_modules/monaco-editor/esm/vs/language/json/json.worker.js node_modules/monaco-editor/esm/vs/language/css/css.worker.js node_modules/monaco-editor/esm/vs/language/html/html.worker.js node_modules/monaco-editor/esm/vs/language/typescript/ts.worker.js --bundle --format=iife --minify --target=es2022 --entry-names=[name] --outdir=../../workspace/files/ui/static/files/ui/js/vendor/monaco",
    "build:monaco-css": "esbuild monaco-theme.css --bundle --minify --loader:.ttf=file --asset-names=fonts/[name] --outfile=../../workspace/files/ui/static/files/ui/css/vendor/monaco/editor.css",
    "build:emoji-picker": "esbuild emoji-picker.js --bundle --format=esm --minify --target=es2022 --outfile=../../workspace/chat/ui/static/chat/ui/js/vendor/emoji-picker/emoji-picker.js",
    "build:emoji-data": "node vendor-copy.mjs emoji-data",
    "build:force-graph": "esbuild force-graph.js --bundle --format=esm --minify --target=es2022 --outfile=../../workspace/notes/ui/static/notes/ui/js/vendor/force-graph/force-graph.js",
    "build:calendar": "node vendor-copy.mjs calendar",
    "build:cropper": "node vendor-copy.mjs cropper",
    "build:vault-onboarding": "esbuild vault-onboarding-bundle.js --bundle --format=iife --minify --target=es2022 --outfile=../../workspace/vault/ui/static/vault/ui/js/vendor/vault-onboarding.js",
    "build:vault": "esbuild vault-bundle.js --bundle --format=iife --minify --target=es2022 --outfile=../../workspace/vault/ui/static/vault/ui/js/vendor/vault-crypto.js",
    "build:css": "tailwindcss -i ./input.css -o ../../workspace/common/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./input.css -o ../../workspace/common/static/css/app.css --watch"
  },
  "dependencies": {
    "@alpinejs/collapse": "3.16.3",
    "@fullcalendar/luxon3": "6.1.15",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@imacrayon/alpine-ajax": "0.12.7",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/plugin-slash": "7.22.1",
    "@zxcvbn-ts/core": "3.0.4",
    "@zxcvbn-ts/language-common": "3.0.4",
    "alpinejs": "3.16.3",
    "cbor-x": "1.6.6",
    "codemirror": "6.0.2",
    "cropperjs": "1.6.2",
    "emoji-picker-element": "1.27.0",
    "emoji-picker-element-data": "1.8.0",
    "force-graph": "1.51.4",
    "fullcalendar": "6.1.15",
    "hash-wasm": "4.12.0",
    "jspdf": "4.2.1",
    "lucide": "1.34.0",
    "luxon": "3.5.0",
    "monaco-editor": "0.45.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "daisyui": "4.12.24",
    "esbuild": "0.28.2",
    "tailwindcss": "3.4.19"
  }
}
