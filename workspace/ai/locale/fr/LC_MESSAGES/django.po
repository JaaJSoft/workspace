#: models.py
#, python-format
msgid ""
"The recording is %(size)s bytes; at most %(limit)s reaches the speech "
"backend. A few seconds of speech is enough."
msgstr ""
"L’enregistrement fait %(size)s octets ; le moteur vocal n’en reçoit que "
"%(limit)s au maximum. Quelques secondes de parole suffisent."

#: models.py
msgid ""
"Transcribe the recording word for word - the speech model aligns the clone "
"on it."
msgstr ""
"Transcrivez l’enregistrement mot pour mot : le modèle vocal s’en sert pour "
"aligner la voix clonée."

#: models.py
msgid "A transcript on its own clones no voice."
msgstr "Une transcription seule ne permet de cloner aucune voix."

#: serializers.py
msgid "Instructions are required for custom actions."
msgstr "Les actions personnalisées demandent des instructions."

#: serializers.py
msgid "Another memory of this assistant already has this key."
msgstr "Un autre souvenir de cet assistant porte déjà cette clé."

#: services/responses.py
msgid "Sorry, I encountered an error generating a response. Please try again."
msgstr ""
"Désolé, une erreur s’est produite pendant la génération de la réponse. "
"Veuillez réessayer."

#: tasks/calendar.py
