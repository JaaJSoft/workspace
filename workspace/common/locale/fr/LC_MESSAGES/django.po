#. Translators: a PHP-style date format (Django's date filter) for a day on a chart's date axis, e.g. "Sep 07".
#: charts.py
msgctxt "chart axis day"
msgid "M d"
msgstr "j N"

#. Translators: a PHP-style date format (Django's date filter) for a month on a chart's date axis, e.g. "Sep 2026".
#: charts.py
msgctxt "chart axis month"
msgid "M Y"
msgstr "N Y"

#: charts.py
#, python-format
msgctxt "chart axis quarter"
msgid "Q%(quarter)s %(year)s"
msgstr "T%(quarter)s %(year)s"

#: dates.py
msgid "just now"
msgstr "à l’instant"

#: dates.py
#, python-format
msgid "%(count)sm ago"
msgstr "il y a %(count)s min"

#: dates.py
#, python-format
msgid "%(count)sh ago"
msgstr "il y a %(count)s h"

#: dates.py
#, python-format
msgid "%(count)sd ago"
msgstr "il y a %(count)s j"

#. Translators: Django date format of a "time ago" label older than a
#. week, "Feb 01". Mirror the month and day order of the browser's
#. Intl short date in your language (French: "j N", "1 juil."); the
#. two only disagree on a few month abbreviations ("fév." / "févr.").
#: dates.py
msgctxt "time ago date"
msgid "M d"
msgstr "j N"

#. Translators: same as "M d", with the year: "Feb 01, 2025".
#: dates.py
msgctxt "time ago date with year"
msgid "M d, Y"
msgstr "j N Y"

