msgstr "%(actor)s a modifié « %(name)s »"

#: views/files.py
msgid "Renaming this file is not allowed."
msgstr "Le renommage de ce fichier n’est pas autorisé."

#: views/files.py
msgid "Shared write access only allows updating file content."
msgstr ""
"L’accès en écriture partagé permet uniquement de mettre à jour le contenu du "
"fichier."

#: views/files.py
#, python-format
msgid "%(actor)s deleted \"%(name)s\""
msgstr "%(actor)s a supprimé « %(name)s »"

