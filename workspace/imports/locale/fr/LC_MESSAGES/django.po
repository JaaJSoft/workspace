#: ui/templates/imports/ui/index.html
msgid ""
"Bring your files and contacts over from another cloud - Nextcloud, any "
"WebDAV host, and more to come."
msgstr ""
"Rapatriez vos fichiers et vos contacts depuis un autre cloud : Nextcloud, "
"n’importe quel hôte WebDAV, et d’autres à venir."

