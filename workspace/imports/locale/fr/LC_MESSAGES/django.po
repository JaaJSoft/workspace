msgstr "Nom d’utilisateur"

#: ui/templates/imports/ui/index.html
msgid "Which connection do you want to import from?"
msgstr "Depuis quelle connexion voulez-vous importer ?"

#: ui/templates/imports/ui/index.html
msgid "Add another connection"
msgstr "Ajouter une autre connexion"

#: ui/templates/imports/ui/index.html
msgid "What should be brought over?"
msgstr "Que faut-il rapatrier ?"

#: ui/templates/imports/ui/index.html
msgid ""
"Other kinds of data (calendars, boards…) will appear here as providers gain "
"them."
msgstr ""
"D’autres types de données (agendas, tableaux…) apparaîtront ici à mesure que "
"les fournisseurs les prendront en charge."

#: ui/templates/imports/ui/index.html
msgid "Remote folder to import"
msgstr "Dossier distant à importer"

#: ui/templates/imports/ui/index.html
msgid "Use this folder"
msgstr "Utiliser ce dossier"

#: ui/templates/imports/ui/index.html
msgid "Empty folder."
msgstr "Dossier vide."

#: ui/templates/imports/ui/index.html
msgid "Import into"
msgstr "Importer dans"

#: ui/templates/imports/ui/index.html
msgid "When a file with the same name exists"
msgstr "Si un fichier du même nom existe"

#: ui/templates/imports/ui/index.html
msgid "Keep both (rename the imported one)"
msgstr "Garder les deux (renommer celui importé)"

#: ui/templates/imports/ui/index.html
msgid "Keep mine (skip the imported one)"
msgstr "Garder le mien (ignorer celui importé)"

#: ui/templates/imports/ui/index.html
msgid "Replace mine with the imported one"
msgstr "Remplacer le mien par celui importé"

#: ui/templates/imports/ui/index.html
msgid "Put everything in a folder named"
msgstr "Tout placer dans un dossier nommé"

#: ui/templates/imports/ui/index.html
msgid "Untick to merge the remote tree directly into the destination."
msgstr ""
"Décochez pour fusionner l’arborescence distante directement dans la "
"destination."

#: ui/templates/imports/ui/index.html
msgid "Address books to import"
msgstr "Carnets d’adresses à importer"

#: ui/templates/imports/ui/index.html
msgid "Listing the address books…"
msgstr "Lecture des carnets d’adresses…"

#: ui/templates/imports/ui/index.html
msgid "No address book on this account."
msgstr "Aucun carnet d’adresses sur ce compte."

#: ui/templates/imports/ui/index.html
msgid ""
"Contact groups become lists. A contact already in the chosen address book "
"(same card, or same email) is updated rather than duplicated."
msgstr ""
"Les groupes de contacts deviennent des listes. Un contact déjà présent dans "
"le carnet choisi (même fiche ou même adresse e-mail) est mis à jour plutôt "
"que dupliqué."

#: ui/templates/imports/ui/index.html
msgctxt "remote connection"
msgid "From"
msgstr "Depuis"

#: ui/templates/imports/ui/index.html
msgctxt "import destination"
msgid "Into"
msgstr "Dans"

