#: ui/static/imports/ui/js/imports.js
msgid ""
"Instance URL, as in your browser (https://cloud.example.org). The WebDAV "
"path is derived from it."
msgstr ""
"URL de l’instance, comme dans votre navigateur (https://cloud.example.org). "
"Le chemin WebDAV en est déduit."

#: ui/static/imports/ui/js/imports.js
msgid ""
"Use an app password (Settings → Security → Devices & sessions), not your "
"login password."
msgstr ""
"Utilisez un mot de passe d’application (Paramètres → Sécurité → Appareils et "
"sessions), pas votre mot de passe de connexion."

#: ui/static/imports/ui/js/imports.js
msgid "Full WebDAV URL of the folder to import from."
msgstr "URL WebDAV complète du dossier à importer."

#: ui/static/imports/ui/js/imports.js
msgid "Password or app token for that account."
msgstr "Mot de passe ou jeton d’application de ce compte."

#: ui/static/imports/ui/js/imports.js
msgid "Root of my files"
msgstr "Racine de mes fichiers"

#: ui/static/imports/ui/js/imports.js
msgid "%(used)s used · %(free)s free"
msgstr "%(used)s utilisés · %(free)s libres"

#: ui/static/imports/ui/js/imports.js
msgid "Checked %(date)s"
msgstr "Vérifiée le %(date)s"

#: ui/static/imports/ui/js/imports.js
msgid "Stopping"
msgstr "Arrêt…"

#: ui/static/imports/ui/js/imports.js
msgid "Errors (%(count)s)"
msgstr "Erreurs (%(count)s)"

#: ui/static/imports/ui/js/imports.js
msgid "%(count)s failed. Retry the import to try it again."
msgid_plural "%(count)s failed. Retry the import to try them again."
