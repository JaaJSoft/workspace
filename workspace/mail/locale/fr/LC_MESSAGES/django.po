#: ui/templates/mail/ui/partials/rules_dialog.html
msgid "Conditions"
msgstr "Conditions"

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid ""
"A condition is either a single check (leaf) or a group combining multiple "
"checks with AND/OR."
msgstr ""
"Une condition est soit une vérification unique (feuille), soit un groupe qui "
"combine plusieurs vérifications avec AND/OR."

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid "Available fields"
msgstr "Champs disponibles"

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid ""
"<span class=\"font-mono\">from, to, cc, recipient, subject, body, folder</"
"span> (text); <span class=\"font-mono\">has_attachments, is_starred</span> "
"(boolean); <span class=\"font-mono\">date</span> (ISO 8601)."
msgstr ""
"<span class=\"font-mono\">from, to, cc, recipient, subject, body, folder</"
"span> (texte) ; <span class=\"font-mono\">has_attachments, is_starred</span> "
"(booléen) ; <span class=\"font-mono\">date</span> (ISO 8601)."

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid "Available ops"
msgstr "Opérateurs disponibles"

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid ""
"Text: <span class=\"font-mono\">contains, equals, starts_with, ends_with, "
"matches_regex, in_list</span>. Boolean: <span class=\"font-mono\">is_true, "
"is_false</span>. Date: <span class=\"font-mono\">greater_than, less_than</"
"span>."
msgstr ""
"Texte : <span class=\"font-mono\">contains, equals, starts_with, ends_with, "
"matches_regex, in_list</span>. Booléen : <span class=\"font-mono\">is_true, "
"is_false</span>. Date : <span class=\"font-mono\">greater_than, less_than</"
"span>."

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid ""
"Add <span class=\"font-mono\">\"case_sensitive\": true</span> to a text leaf "
"for exact case matching (default: false)."
msgstr ""
"Ajoutez <span class=\"font-mono\">\"case_sensitive\": true</span> à une "
"condition texte pour respecter la casse (par défaut : false)."

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid "Actions (flat list)"
msgstr "Actions (liste simple)"

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid ""
"Types: <span class=\"font-mono\">add_label, remove_label</span> (need <span "
"class=\"font-mono\">label_id</span>); <span class=\"font-mono\">mark_read, "
"mark_unread, star, unstar, delete</span> (no args); <span class=\"font-"
"mono\">move_to_folder</span> (needs <span class=\"font-mono\">folder_id</"
"span>)."
msgstr ""
"Types : <span class=\"font-mono\">add_label, remove_label</span> (avec <span "
"class=\"font-mono\">label_id</span>) ; <span class=\"font-mono\">mark_read, "
"mark_unread, star, unstar, delete</span> (sans argument) ; <span "
"class=\"font-mono\">move_to_folder</span> (avec <span class=\"font-"
"mono\">folder_id</span>)."

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid "Limits: max 5 nesting levels, max 20 leaf conditions per rule."
msgstr ""
"Limites : 5 niveaux d’imbrication et 20 conditions simples au plus par règle."

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid "Finding label/folder UUIDs"
msgstr "Trouver l’UUID d’une étiquette ou d’un dossier"

#: ui/templates/mail/ui/partials/rules_dialog.html
msgid ""
"Use the Simple mode to pick a label or folder, then switch to Advanced to "
"see its UUID inlined in the JSON."
msgstr ""
"Choisissez une étiquette ou un dossier en mode Simple, puis passez en mode "
"Avancé pour voir son UUID dans le JSON."

