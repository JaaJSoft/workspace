#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Create</strong> &mdash; Click the <kbd class=\"kbd kbd-xs\">+</kbd> "
"button in the note list panel to create a new note."
msgstr ""
"<strong>Créer</strong> &mdash; Cliquez sur le bouton <kbd class=\"kbd kbd-"
"xs\">+</kbd> de la liste des notes pour créer une note."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Edit</strong> &mdash; Select a note to open the Markdown editor with "
"live preview."
msgstr ""
"<strong>Modifier</strong> &mdash; Sélectionnez une note pour l’ouvrir dans "
"l’éditeur Markdown avec aperçu en direct."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Rename</strong> &mdash; Click the note title in the editor toolbar "
"to rename it."
msgstr ""
"<strong>Renommer</strong> &mdash; Cliquez sur le titre de la note dans la "
"barre d’outils de l’éditeur pour la renommer."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Favorite</strong> &mdash; Click the star icon to mark a note as "
"favorite."
msgstr ""
"<strong>Favori</strong> &mdash; Cliquez sur l’étoile pour ajouter une note "
"aux favoris."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Tags</strong> &mdash; Use the tag manager to organize notes with "
"labels."
msgstr ""
"<strong>Étiquettes</strong> &mdash; Utilisez le gestionnaire d’étiquettes "
"pour classer vos notes."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Delete</strong> &mdash; Click the trash icon in the toolbar "
"(confirmation can be toggled in preferences)."
msgstr ""
"<strong>Supprimer</strong> &mdash; Cliquez sur la corbeille de la barre "
"d’outils (la confirmation se règle dans les préférences)."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid "Folders & Organization"
msgstr "Dossiers et organisation"

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Folders</strong> &mdash; Organize notes in a nested folder tree (up "
"to 4 levels deep)."
msgstr ""
"<strong>Dossiers</strong> &mdash; Rangez vos notes dans une arborescence de "
"dossiers (jusqu’à 4 niveaux)."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Group folders</strong> &mdash; Create shared folders linked to your "
"groups."
msgstr ""
"<strong>Dossiers de groupe</strong> &mdash; Créez des dossiers partagés liés "
"à vos groupes."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Quick access</strong> &mdash; Use My Notes, Favorites, Recent, and "
"Journal views in the sidebar."
msgstr ""
"<strong>Accès rapide</strong> &mdash; Passez d’une vue à l’autre depuis la "
"barre latérale : Mes notes, Favoris, Récentes et Journal."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Context menu</strong> &mdash; Right-click folders for quick actions."
msgstr ""
"<strong>Menu contextuel</strong> &mdash; Faites un clic droit sur un dossier "
"pour ses actions rapides."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Tags</strong> &mdash; Star a tag in the tag manager to keep it in "
"the sidebar; click a chip on a note to see everything with that tag."
msgstr ""
"<strong>Étiquettes</strong> &mdash; Marquez une étiquette d’une étoile dans "
"le gestionnaire pour la garder dans la barre latérale ; cliquez sur une "
"étiquette d’une note pour voir tout ce qui la porte."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Daily notes</strong> &mdash; The journal automatically creates a "
"note for today's date."
msgstr ""
"<strong>Notes quotidiennes</strong> &mdash; Le journal crée automatiquement "
"une note à la date du jour."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Auto-folder</strong> &mdash; A dedicated \"Journal\" folder is "
"created the first time you use it."
msgstr ""
"<strong>Dossier automatique</strong> &mdash; Un dossier « Journal » dédié "
"est créé à la première utilisation."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid ""
"<strong>Toggle</strong> &mdash; Show or hide the Journal entry in "
"preferences."
msgstr ""
"<strong>Affichage</strong> &mdash; Affichez ou masquez l’entrée Journal dans "
"les préférences."

#: ui/templates/notes/ui/partials/help_dialog.html
msgid "Notes use a rich Markdown editor with support for:"
msgstr ""
"Les notes s’écrivent dans un éditeur Markdown enrichi qui prend en charge :"

#: ui/templates/notes/ui/partials/sidebar.html
msgid "Graph"
msgstr "Graphe"
