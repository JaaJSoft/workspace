msgstr "Depuis votre kit de secours. Tirets et casse ignorés."

#: ui/templates/vault/ui/partials/password_dialog.html
msgid "Recovery key remembered on this device. It is used without being shown."
msgstr ""
"Clé de récupération mémorisée sur cet appareil. Elle est utilisée sans être "
"affichée."

#: ui/templates/vault/ui/partials/password_dialog.html
msgid "New master password"
msgstr "Nouveau mot de passe principal"

#: ui/templates/vault/ui/partials/password_floor_checklist.html
