msgstr "Assez robuste pour résister aux tentatives"

#: ui/templates/vault/ui/partials/password_floor_checklist.html
msgid "Both fields match"
msgstr "Les deux champs correspondent"

#: ui/templates/vault/ui/partials/password_floor_checklist.html
msgid "Not in a known data breach"
msgstr "Absent des fuites de données connues"

#: ui/templates/vault/ui/partials/password_floor_checklist.html
msgid "Checking known data breaches..."
msgstr "Vérification des fuites de données connues..."

#: ui/templates/vault/ui/partials/password_floor_checklist.html
msgid "Found in a public data breach - pick another one"
msgstr "Trouvé dans une fuite de données publique - choisissez-en un autre"

#: ui/templates/vault/ui/partials/password_floor_checklist.html
msgid "Breach check unavailable - you can continue"
msgstr "Vérification des fuites indisponible - vous pouvez continuer"

#: ui/templates/vault/ui/partials/switcher_menu.html
